# Copy this file to .env (in this same folder) and fill in your own values.
# .env holds your secrets and is never committed. This example file is.

# From MongoDB Atlas: Connect > Drivers. Put in your database user's password,
# and the database name (rasoi_dev) right after "mongodb.net/".
MONGODB_URI=mongodb+srv://rasoi-app:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/rasoi_dev?retryWrites=true&w=majority&appName=rasoi

PORT=4000

# Only if you see "querySrv ECONNREFUSED" when the server starts: your router can't do the
# DNS lookup Atlas needs, so use public DNS servers instead. Leave empty otherwise.
DNS_SERVERS=